# All values are optional for local demo. Without them PAYSA uses an in-memory
# repository and deterministic (non-AI) fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=
# Required on serverless hosts (Vercel): 32+ random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
FIRESTORE_PROJECT_ID=
# Service-account JSON (one line) for Firestore on hosts without Google credentials, e.g. Vercel.
FIREBASE_SERVICE_ACCOUNT=
